# =============================================================================
# Project00 — Environment Variables Template
# Copy to .env.local for local development
# NEVER commit .env.local to git
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase
# Found at: https://supabase.com/dashboard/project/_/settings/api
# -----------------------------------------------------------------------------

# Public keys — safe to expose in browser code
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — SERVER SIDE ONLY. Never expose to client. Never commit.
# Used by: API route handlers, Edge Functions
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# -----------------------------------------------------------------------------
# LiveKit
# Found at: https://cloud.livekit.io → Your project → Settings
# -----------------------------------------------------------------------------

# API credentials — SERVER SIDE ONLY
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# WebSocket URL — public, used in browser for connection
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud

# -----------------------------------------------------------------------------
# App URLs
# -----------------------------------------------------------------------------

# Production URLs (set in Vercel for production)
NEXT_PUBLIC_APP_URL=https://app.example.com
NEXT_PUBLIC_PUBLIC_URL=https://www.example.com

# Development host routing:
# 'public' → serve www (editorial) experience at localhost:3000
# 'app'    → serve app (sanctuary) experience at localhost:3000
NEXT_PUBLIC_DEFAULT_HOST=public

# -----------------------------------------------------------------------------
# Internal secrets (server-side only)
# -----------------------------------------------------------------------------

# Used to authenticate the RSS feed sync cron job
CRON_SECRET=generate-with-openssl-rand-hex-32

# Supabase webhook signing secret (from Supabase dashboard → Webhooks)
SUPABASE_WEBHOOK_SECRET=your-webhook-secret

# -----------------------------------------------------------------------------
# Matrix (Synapse Homeserver + Client-Side E2EE)
# -----------------------------------------------------------------------------

# Public homeserver URL accessed by browser matrix-js-sdk (app.* only)
NEXT_PUBLIC_MATRIX_HOMESERVER_URL=http://127.0.0.1:8008
NEXT_PUBLIC_MATRIX_SERVER_NAME=sanctuary.local

# Internal homeserver URL used by Next.js server-side routes (Synapse Admin API)
MATRIX_HOMESERVER_INTERNAL_URL=http://127.0.0.1:8008

# SERVER SIDE ONLY — NEVER expose to client or commit to git
# Token belonging to a dedicated non-human server admin provisioning account
SYNAPSE_ADMIN_ACCESS_TOKEN=your-synapse-admin-token-here

# Server-only secret used to derive opaque Matrix usernames from Supabase UUIDs
MATRIX_USER_HMAC_SECRET=generate-with-openssl-rand-hex-32

# Optional development-only flag for local 2-account testing without cloud Supabase
MATRIX_LOCAL_POC_MODE=false

# -----------------------------------------------------------------------------
# Python FastAPI Backend Service
# -----------------------------------------------------------------------------

# Runtime environment: development | production
APP_ENV=development

# Internal URL used by Next.js `/api/*` rewrites to reach FastAPI
# Local dev: http://127.0.0.1:8000 | Docker Compose: http://backend:8000
BACKEND_INTERNAL_URL=http://127.0.0.1:8000

# Enable scheduled in-process background tasks (RSS feed sync + ephemeral media purge)
ENABLE_BACKGROUND_WORKER=false

